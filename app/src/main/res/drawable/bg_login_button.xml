<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1E88E5" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#1E88E5"
                android:endColor="#42A5F5"
                android:angle="270" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
