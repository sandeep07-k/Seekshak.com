<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:paddingTop="30dp">

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_verify_otp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/goToBackPage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back" />

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter verification code"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="24dp" />

            <!-- Subtitle with edit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We sent a 6-digit code to +91XXXXXXXXXX"
                    android:textSize="14sp"
                    android:textColor="#6A6A6A" />

                <ImageView
                    android:id="@+id/edit_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Edit Number" />
            </LinearLayout>

            <!-- OTP Layout -->
            <LinearLayout
                android:id="@+id/otp_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="6">

                <!-- Repeat 6 EditTexts -->
                <EditText
                    android:id="@+id/otp1"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />

                <EditText
                    android:id="@+id/otp2"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />

                <EditText
                    android:id="@+id/otp3"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />

                <EditText
                    android:id="@+id/otp4"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />

                <EditText
                    android:id="@+id/otp5"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />

                <EditText
                    android:id="@+id/otp6"
                    style="@style/OtpEditText"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:hint="@string/space"
                    android:inputType="number"
                    android:maxLength="1" />
            </LinearLayout>

            <!-- Resend Timer -->
            <TextView
                android:id="@+id/button_resend_otp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_gravity="start"
                android:text="Resend code in 30s"
                android:textColor="#003B84"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- White Bottom Strip -->
    <View
        android:id="@+id/whiteBackgroundBottom"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Verify Button -->
    <Button
        android:id="@+id/button_verify_otp"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_margin="10dp"
        android:backgroundTint="#003B84"
        android:text="Verify"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
