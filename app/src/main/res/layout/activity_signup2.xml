<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="30dp"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp"
    android:background="@android:color/white"
    tools:context=".SignupActivity2">

    <ImageView
        android:id="@+id/goToBackPage"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enter verification code"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/goToBackPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="We sent a 6-digit code to +91XXXXXXXXXX"
        android:textSize="14sp"
        android:textColor="#6A6A6A"
        android:layout_marginTop="8dp"
        android:gravity="left"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Edit icon to change number -->
    <ImageView
        android:id="@+id/edit_number"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit Number"
        app:layout_constraintTop_toTopOf="@id/subtitle"
        app:layout_constraintStart_toEndOf="@id/subtitle"
        android:layout_marginStart="6dp"/>

    <!-- OTP Fields -->
    <LinearLayout
        android:id="@+id/otp_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:weightSum="6">

        <!-- Repeat this EditText 6 times -->
        <EditText
            android:id="@+id/otp1"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:layout_marginStart="6dp"
            android:hint="@string/space" />

        <EditText
            android:id="@+id/otp2"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:hint="@string/space" />

        <EditText
            android:id="@+id/otp3"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:hint="@string/space" />

        <EditText
            android:id="@+id/otp4"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:hint="@string/space" />

        <EditText
            android:id="@+id/otp5"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:hint="@string/space" />

        <EditText
            android:id="@+id/otp6"
            android:inputType="number"
            android:maxLength="1"
            style="@style/OtpEditText"
            android:hint="@string/space" />
    </LinearLayout>




    <TextView
        android:id="@+id/button_resend_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend code "
        android:textColor="#003B84"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/otp_layout"
        app:layout_constraintStart_toStartOf="parent" />


    <Button
        android:id="@+id/button_verify_otp"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Verify"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:backgroundTint="#003B84"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"  />




</androidx.constraintlayout.widget.ConstraintLayout>
