<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_blue"
    android:fitsSystemWindows="true"
    android:paddingTop="30dp">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/verifyOtpButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back" />

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter verification code"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="24dp" />

            <!-- Subtitle with edit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We sent a 6-digit code to +91XXXXXXXXXX"
                    android:textSize="14sp"
                    android:textColor="#6A6A6A" />

                <ImageView
                    android:id="@+id/edit_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Edit Number" />
            </LinearLayout>

            <!-- OTP Layout -->
            <LinearLayout
                android:id="@+id/otp_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="6">

                <!-- Repeat this 6 times -->
                <EditText
                    android:id="@+id/otp1"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp2"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp3"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp4"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp5"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp6"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginHorizontal="4dp"
                    android:hint="@string/space" />
            </LinearLayout>

            <!-- Resend Timer -->
            <TextView
                android:id="@+id/resend_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend code in 30s"
                android:textColor="#003B84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="26dp"
                android:layout_gravity="start" />
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/whiteBackgroundBottom"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/verifyOtpButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Verify"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#003B84"
            android:layout_margin="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"  />

</androidx.constraintlayout.widget.ConstraintLayout>
