<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/post_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/layout_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- From and To Date with Three Dot Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/from_to_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="FROM: 21 APR 2025 - TO: 21 MAY 2025"
                android:textColor="#000000"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/moreOptionsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_threedots_hori"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options" />
        </LinearLayout>

        <!-- Section: Heading -->
        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Need a Tutor For :"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#0F427C"
            android:background="@drawable/rectangle_p"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tuition_Code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Tuition Code: 12345"
            android:textColor="#0D47A1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:background="@drawable/tuition_code_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />

        <!-- Section: Class Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class Info"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#0F427C"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/class_Details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class: 10"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/subject_Details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject: Math, Science"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/board_Details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Education Board: CBSE"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />



        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#CCCCCC" />

        <!-- Section: Class Timing -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timing &amp; Schedule"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#0F427C" />


        <TextView
            android:id="@+id/class_Timing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class Timing: 5 PM – 6 PM"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/class_Schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class Schedule: Mon to Sat"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#CCCCCC" />

        <!-- Section: Address & Preferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address &amp; Preferences"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#0F427C" />



        <TextView
            android:id="@+id/mode_Of_Class"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Online"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="clip_horizontal"
            android:layout_marginTop="4dp">


            <TextView
                android:id="@+id/location_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address: Sublocality, City"
                android:textColor="#000000"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/location_icon"
                android:layout_width="16dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location_pin"
                android:layout_marginStart="4dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Location Icon"
                />



        </LinearLayout>




        <TextView
            android:id="@+id/gender_Preference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender Preference: Female"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/min_Qualification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Min. Qualification: B.Sc"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/fee_Details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expected Fee: ₹1500/month"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/demo_Class_Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Demo Class Date: 20 Jul 2025"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/special_Requirement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Special Req: "
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_active_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_Edit_Details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Details"
                android:backgroundTint="#FFA500"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_total_applications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applications"
                android:backgroundTint="#0F427C"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
        <View
            android:id="@+id/whiteBackgroundBottom"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@android:color/white"
            android:visibility="gone"/>


    </LinearLayout>
    <!-- Expired Actions -->
    <LinearLayout
        android:id="@+id/layout_expired_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:gravity="end"
        android:visibility="gone"
        android:paddingEnd="12dp"
        android:layout_marginTop="490dp">

        <Button
            android:id="@+id/btn_mark_filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as Filled"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_repost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repost"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_filled_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone"
        android:paddingEnd="15dp"
        android:layout_marginTop="505dp">


        <Button
            android:id="@+id/btn_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove"
            android:backgroundTint="#F44336"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />


    </LinearLayout>
    <TextView
        android:id="@+id/filledText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/white"
        android:layout_marginTop="270dp"
        android:text="Marked as Filled"
        android:textSize="16sp"
        android:textColor="#F44336"
        android:textAlignment="center"
        android:textStyle="bold"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/expiredText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/white"
        android:layout_marginTop="270dp"
        android:text="Expired"
        android:textSize="16sp"
        android:textColor="#F44336"
        android:textAlignment="center"
        android:textStyle="bold"
        android:visibility="gone"/>
</androidx.cardview.widget.CardView>
