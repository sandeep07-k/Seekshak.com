<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rectangle_2"
            android:padding="12dp">

            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginTop="9dp"
                android:src="@drawable/ic_back_arrow"
                android:layout_marginEnd="15dp"
                android:layout_alignParentStart="true"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="8dp"
                android:layout_toEndOf="@+id/back_arrow"
                android:text="My Account"
                android:textColor="#0F427C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/logo_1_1"
                android:contentDescription="Logo" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <RelativeLayout
                    android:layout_width="280dp"
                    android:layout_height="195dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/profile_card_bg"
                    android:layout_gravity="center_horizontal"
                    android:padding="0dp">

                    <TextView
                        android:layout_width="117dp"
                        android:layout_height="35dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_viewprofile"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:lineSpacingExtra="4sp"
                        android:text="Edit Profile >>"
                        android:textColor="#AAD9FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/ic_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="76dp"
                        android:layout_marginEnd="-2dp"
                        android:background="@drawable/ic_camera"
                        android:foregroundGravity="center_vertical" />

                    <ImageView
                        android:id="@+id/profile_icon"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_profilecicle"
                        android:contentDescription="profile"
                        android:padding="8dp"
                        android:src="@drawable/ic_user" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/profile_icon"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="35dp"
                            android:text="User ID : "
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/user_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User ID"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/profile_icon"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="3dp"
                        android:text="Sandeep Kumar"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_mobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/user_name"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:text="Mobile No. : "
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mobile_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/user_name"
                        android:layout_marginStart="1dp"
                        android:layout_marginTop="2dp"
                        android:layout_toEndOf="@+id/text_mobile"
                        android:text="+91 XXXXXXXXXX"
                        android:textColor="#00213D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/text_mobile"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="0dp"
                        android:text="Email : "
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/text_email"
                        android:layout_marginStart="22dp"
                        android:text="sandeepkumar9334@gmail.com"
                        android:textColor="#00213D"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/favourite_btn"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_marginStart="66dp"
                        android:layout_marginTop="0dp"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/rectangle_5"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Favorites"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/transactions_btn"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_below="@+id/favourite_btn"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="26dp"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/rectangle_6"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Transactions"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_btn"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_marginStart="0dp"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@+id/transactions_btn"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/rectangle_7"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Settings"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_support"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_below="@+id/settings_btn"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="0dp"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/rectangle_8"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Help &amp; Support"
                        android:textColor="@color/orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/about_us"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_below="@+id/help_support"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="20dp"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/rectangle_9"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="About Us"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/logoutButton"
                        android:layout_width="254dp"
                        android:layout_height="47dp"
                        android:layout_below="@+id/about_us"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="0dp"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/rectangle_10"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Log Out"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>




            </LinearLayout>


        </ScrollView>
    </LinearLayout>
</FrameLayout>
