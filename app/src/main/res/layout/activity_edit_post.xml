<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#B3E5FC"
    android:paddingTop="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#B3E5FC"
        android:layout_marginTop="10dp"
        android:padding="12dp">

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_back_arrow"
            android:layout_marginTop="8dp"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Tutor Form"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_centerInParent="true"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="20dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="110dp"
        android:background="@drawable/form_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="35dp"
            android:orientation="vertical">

            <!-- Class Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Class *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/classEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:completionThreshold="0" /> <!-- Shows suggestions after typing 1 character -->
            </com.google.android.material.textfield.TextInputLayout>


            <!-- Subject Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Subjects *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/subjectEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:maxLines="2"
                    android:completionThreshold="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Education Board -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Education Board *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/edu_board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:completionThreshold="0"
                    android:inputType="text"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tuition Fee and Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuition Fee (₹) *"
                android:textStyle="bold"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/feeEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:inputType="text"
                        android:hint="e.g. 500–1000"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>

                <RadioGroup
                    android:id="@+id/feeTypeRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">

                    <RadioButton
                        android:id="@+id/radioHourly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hourly" />

                    <RadioButton
                        android:id="@+id/radioMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:layout_marginStart="8dp" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Location *">

                    <AutoCompleteTextView
                        android:id="@+id/locationEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="false"
                        android:enabled="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/fetchLocationButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="12dp"
                    android:text="Fetch location..."
                    android:textColor="#007BFF"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_use_location"
                    android:drawablePadding="6dp"
                    android:backgroundTint="@color/teal_700"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:contentDescription="Fetch Location"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>




            <!-- Class Schedule -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Class Schedule (days in a week) *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/classScheduleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:completionThreshold="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Class Timing -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Class Timing *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/classTimingEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:completionThreshold="0"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- Gender Preference -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gender Preference *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/genderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:completionThreshold="0"/>
            </com.google.android.material.textfield.TextInputLayout>




            <!-- Mode of Class -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mode of Class *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/modeOfClassesSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:completionThreshold="0"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Qualification -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Minimum Qualification *"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/minQualificationEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:completionThreshold="0"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Demo Date -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Demo Class Date ( if any )"
                android:layout_marginBottom="12dp"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconContentDescription="Select Date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/demoClassDateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:imeOptions="actionNext"
                    android:clickable="true"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>


            <!-- Special Requirement -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Special Requirements (if any)"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/specialRequirementEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="2"
                    android:imeOptions="actionDone"
                    android:completionThreshold="1"
                    android:dropDownHeight="200dp" />
            </com.google.android.material.textfield.TextInputLayout>




            <!-- Submit Button -->
            <Button
                android:id="@+id/updateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update"
                android:backgroundTint="#0288D1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="12dp"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
