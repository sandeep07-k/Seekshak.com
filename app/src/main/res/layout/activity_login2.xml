<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/white"
    tools:context=".LoginActivity2">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/goToBackPage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back" />

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter verification code"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="24dp" />

            <!-- Subtitle + edit icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We sent a 6-digit code to +91XXXXXXXXXX"
                    android:textSize="14sp"
                    android:textColor="#6A6A6A" />

                <ImageView
                    android:id="@+id/edit_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Edit Number"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- OTP Fields -->
            <LinearLayout
                android:id="@+id/otpContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:weightSum="6">

                <EditText
                    android:id="@+id/otp1"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:layout_marginStart="6dp"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp2"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp3"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp4"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp5"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:hint="@string/space" />

                <EditText
                    android:id="@+id/otp6"
                    android:inputType="number"
                    android:maxLength="1"
                    style="@style/OtpEditText"
                    android:hint="@string/space" />
            </LinearLayout>

            <!-- Resend OTP -->
            <TextView
                android:id="@+id/resendOtpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend code"
                android:textColor="#003B84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="26dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom strip for button -->
    <LinearLayout
        android:id="@+id/bottomStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/verifyOtpButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Verify"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#003B84" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
