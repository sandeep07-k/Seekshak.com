<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Seekshakcom"
        tools:targetApi="31">



        <!-- LoginActivity is now the launcher activity with proper theme -->
        <activity
            android:name=".SplashActivity1"
            android:exported="true"
            android:theme="@style/Theme.Seekshakcom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Other activities -->
        <activity android:name=".SplashActivity2" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".SignupActivity" />
        <activity android:name=".StudentHomeActivity"
            android:windowSoftInputMode="adjustPan"/>
        <activity android:name=".TutorHomeActivity" />
        <activity android:name=".InstituteHomeActivity" />
        <activity android:name=".ForgotPasswordActivity" />
        <activity android:name=".ResetPasswordActivity" />
        <activity android:name=".SignupActivity2"/>
        <activity android:name=".SignupActivity3"/>









    </application>

</manifest>
